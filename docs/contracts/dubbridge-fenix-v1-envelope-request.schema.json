{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fenix.local/integrations/dubbridge/v1/envelope/request",
  "title": "DubBridge → Fenix neutral S2S request envelope (PROPOSED, no registered workflow)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "capability_key",
    "input_schema_version",
    "trace_id",
    "source",
    "input"
  ],
  "properties": {
    "contract_version": {
      "const": "1"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,96}$"
    },
    "capability_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){1,6}$",
      "maxLength": 96
    },
    "input_schema_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,2}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,96}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "org_id"
      ],
      "properties": {
        "product": {
          "const": "dubbridge"
        },
        "org_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "input": {
      "type": "object",
      "maxProperties": 64
    }
  }
}
