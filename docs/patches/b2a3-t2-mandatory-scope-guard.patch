+#!/usr/bin/env python3
+"""Only adjusts existing B2.A3 test harness assumptions to the mandatory scope guard.
+Run in the target repository with a clean, verified baseline checkout.
+"""
+from pathlib import Path
+p = Path('internal/api/middleware/dubbridge_service_auth_test.go')
+s = p.read_text()
+# Exactly five existing calls, all old two-argument form.
+assert s.count('DubBridgeServiceAuth(') == 5, f'Unexpected original test API usage: {s.count("DubBridgeServiceAuth(")}'
+s = s.replace('DubBridgeServiceAuth(verifier, http.HandlerFunc', 'DubBridgeServiceAuth(verifier, nil, http.HandlerFunc')
+s = s.replace('DubBridgeServiceAuth(v, http.HandlerFunc', 'DubBridgeServiceAuth(v, nil, http.HandlerFunc')
+s = s.replace('DubBridgeServiceAuth(tt.verifier, http.HandlerFunc', 'DubBridgeServiceAuth(tt.verifier, nil, http.HandlerFunc')
+s = s.replace('DubBridgeServiceAuth(&verifierStub{ident: defaultIdentity()}, http.HandlerFunc', 'DubBridgeServiceAuth(&verifierStub{ident: defaultIdentity()}, nil, http.HandlerFunc')
+s = s.replace('DubBridgeServiceAuth(&verifierStub{ident: defaultIdentity()}, nil)', 'DubBridgeServiceAuth(&verifierStub{ident: defaultIdentity()}, nil, nil)')
+# Existing GET happy path must now use an authorized POST envelope; GET without
+# a persisted scoped operation resolver must fail-closed. This is the first test.
+old = 'req := httptest.NewRequest(http.MethodGet, "/integrations/dubbridge/operations/op123", nil)'
+assert s.count(old) == 2
+s = s.replace(old, 'req := httptest.NewRequest(http.MethodPost, "/integrations/dubbridge/operations", strings.NewReader(s2sEnvelope(testSource("org", "project"), `{}`)))', 1)
+start = s.index('func TestDubBridgeServiceAuthIdentityAndScope')
+end = s.index('func TestDubBridgeServiceAuthRejectsHumanAndMalformed')
+section = s[start:end]
+needle = 'req.Header.Set("Authorization", "Bearer "+token)'
+assert section.count(needle) == 1
+section = section.replace(needle, needle+'\n\treq.Header.Set("Content-Type", "application/json")')
+s = s[:start]+section+s[end:]
+# The existing legacy body test supplied invalid repeated x bytes. Under strict
+# envelope decoding, an in-limit invalid body is rejected before the handler.
+needle = '{DubBridgeS2SMaxRequestBytes, "application/json", 202, true}'
+assert s.count(needle) == 1
+s = s.replace(needle, '{DubBridgeS2SMaxRequestBytes, "application/json", 400, false}')
+assert s.count('DubBridgeServiceAuth(') == 5
+p.write_text(s)
