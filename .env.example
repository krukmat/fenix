# FenixCRM — Environment Variables Example
# Copy to .env and fill in your values
# cp .env.example .env

# ─── Go Backend ────────────────────────────────────────────────────────────────
# REQUIRED in production: use a unique secret of at least 32 characters.
# Leave blank here so production Compose fails closed until an operator supplies it.
JWT_SECRET=

# SQLite database path (relative to binary or absolute)
DATABASE_URL=./data/fenixcrm.db

# Server port (default: 8080)
PORT=8080

# ─── Production deployment contract ───────────────────────────────────────────
# Copy this file to a non-versioned production environment file and fill every
# value in this section before running docker compose -f docker-compose.prod.yml.
# FENIX_DATA_DIR and FENIX_OLLAMA_DIR must be directories on the mounted DO Volume.
FENIX_DATA_DIR=/srv/fenix/data
FENIX_OLLAMA_DIR=/srv/fenix/ollama
DOMAIN=app.example.com
BFF_ORIGIN=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
BFF_CORS_ALLOWED_ORIGINS=https://app.example.com
SESSION_SECRET=

# ─── Ollama (local embeddings only in production) ─────────────────────────────
# Compose connects this service at http://ollama:11434 and starts it by default.
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model — nomic-embed-text produces 768-dimensional vectors
OLLAMA_MODEL=nomic-embed-text

# Production Compose uses openai-compat chat and Ollama embeddings. Do not put
# provider credentials in Git or in this example file.
CHAT_PROVIDER=openai-compat
EMBED_PROVIDER=ollama

# OpenAI-compatible chat provider (DigitalOcean Serverless Inference for the POC)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ─── BFF ───────────────────────────────────────────────────────────────────────
BFF_PORT=3000
BACKEND_URL=http://localhost:8080

# ─── Mobile (Expo) ─────────────────────────────────────────────────────────────
# Leave empty to disable Sentry crash reporting
EXPO_PUBLIC_SENTRY_DSN=

# BFF URL for mobile API calls
EXPO_PUBLIC_BFF_URL=http://localhost:3000
